{
  "name": "tx402",
  "version": "0.1.0",
  "private": true,
  "description": "Plain-English explanations of Algorand transactions, as a pay-per-call API.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node test/decoder.test.js && node test/rateLimit.test.js && node test/payments.test.js && node test/index.test.js && node test/index.paid.test.js",
    "smoke": "node scripts/smoke-phase3.mjs",
    "smoke:paid": "node scripts/pay-and-explain.mjs",
    "phase4:check": "node scripts/check-phase4-mainnet.mjs",
    "phase5:check": "node scripts/check-phase5-buyer.mjs",
    "phase5:settle": "node scripts/pay-and-explain.mjs",
    "example:client": "node examples/node-client.mjs",
    "mcp": "node packages/tx402-mcp/bin/tx402-mcp.mjs",
    "mcp:pack": "npm pack --dry-run --workspace tx402-mcp"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@x402/avm": "^2.19.0",
    "@x402/core": "^2.19.0",
    "@x402/express": "^2.19.0",
    "@x402/extensions": "^2.19.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.3.0"
  },
  "keywords": [
    "algorand",
    "x402",
    "transaction",
    "explainer",
    "agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/fetch": "^2.19.0",
    "algosdk": "^3.6.0"
  }
}
