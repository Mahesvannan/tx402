# Copy to .env and fill in. NEVER commit .env - it is in .gitignore for a reason.

PORT=4021
# HOST defaults to 0.0.0.0, which is required by public PaaS networking.
# HOST=0.0.0.0

# Phase 3 deploys behind a trusted reverse proxy/load balancer should set
# TRUST_PROXY=1 so req.ip reflects the real client IP for rate limiting.
# Only enable it when the proxy overwrites inbound X-Forwarded-For.
# TRUST_PROXY=1

# Optional: override the public indexer if you hit rate limits later.
# Per-network on purpose - setting only one never silently affects the other.
# MAINNET_INDEXER_URL=https://mainnet-idx.algonode.cloud
# TESTNET_INDEXER_URL=https://testnet-idx.algonode.cloud

# ---------------------------------------------------------------------------
# PHASE 2 - Testnet x402. The middleware is wired in (src/payments.js), but
# stays OFF (explain is free) until PAY_TO below is actually set.
#
# USDC_ASSET_ID is intentionally left commented out: src/payments.js derives
# the correct USDC asset id from NETWORK automatically (Testnet vs Mainnet).
# Only uncomment it if you need a NON-standard asset - and if you do, the
# server will refuse to boot if it detects the other network's canonical
# USDC id here, since that almost always means a stale .env after flipping
# NETWORK for Phase 4.
# ---------------------------------------------------------------------------
FACILITATOR_URL=https://facilitator.goplausible.xyz
NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# USDC_ASSET_ID=10458941
PAY_TO=YOUR_TESTNET_ADDRESS_OPTED_IN_TO_TESTNET_USDC
# EXPLAIN_PRICE_USD=$0.005

# ---------------------------------------------------------------------------
# PHASE 4 - Mainnet. Flip NETWORK and PAY_TO. USDC_ASSET_ID auto-follows
# NETWORK - leave it commented out unless you have a specific reason not to.
# ---------------------------------------------------------------------------
# NETWORK=algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
# PAY_TO=YOUR_MAINNET_ADDRESS_OPTED_IN_TO_USDC
#
# Use the SAME PAY_TO for the whole competition. It is your leaderboard identity.
